<resources>
    <string name="app_name">小音</string>
    <string name="usage">在**手机上**对小音说「放首晴天」，歌就会从手机的 QQ 音乐里播出来（用电脑或桌宠说话时仍然播在电脑上，互不影响）。</string>
    <string name="host_hint">电脑地址，例如 192.168.1.5:7860</string>
    <string name="connect">连接</string>
    <string name="disconnect">断开</string>
    <string name="discover">🔍 自动发现服务器（推荐）</string>
    <string name="settings">⚙ 设置</string>

    <string name="voice_start">🎙️ 开始对话</string>
    <string name="voice_stop">⏹ 结束对话</string>
    <string name="continuous_off">🔁 连续 关</string>
    <string name="continuous_on">🔁 连续 开</string>

    <string name="orb_off">🎙️</string>
    <string name="orb_idle">👂</string>
    <string name="orb_wake">👋</string>
    <string name="orb_think">🤔</string>
    <string name="orb_speak">🔊</string>
    <string name="orb_error">⚠️</string>

