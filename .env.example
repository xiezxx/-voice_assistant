# Claude API Key (从 https://console.anthropic.com 获取)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# DeepSeek API Key (从 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=sk-xxxxxxxx

# ── 唤醒词（说「小音」唤醒，默认开启）─────────────────────
# 开启/关闭免提唤醒（1=开，0=关）
WAKE_WORD_ENABLED=1
# sherpa-onnx 本地关键词检测（默认方案，模型已随仓库提供）
# KWS_MODEL_DIR=models/kws-wenetspeech
# WAKE_KEYWORDS_FILE=models/wake_keywords.txt
# 检测阈值（0-1，越小越灵敏、越易误触发）
KWS_KEYWORDS_THRESHOLD=0.25
KWS_KEYWORDS_SCORE=1.0

# Whisper 模型大小: tiny, base, small, medium, large-v3
# tiny 适合快速测试，medium/large 精度更高
WHISPER_MODEL=base

# 使用的设备: cpu 或 cuda
WHISPER_DEVICE=cpu

# 语音活动检测灵敏度 (0-1, 越低越灵敏)
VAD_THRESHOLD=0.02

# 静音多少秒后判定用户说完话（0.8 响应更快；说话爱停顿就调回 1.0）
SILENCE_DURATION=0.8

# 连续对话：打开开关后，回复完继续听下一句，超过这个秒数没说话就休眠回待唤醒
CONTINUOUS_TIMEOUT=10

# HuggingFace Token (从 https://huggingface.co/settings/tokens 创建，可选)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Whisper 模型下载源：代码里默认已走 hf-mirror.com（国内直连 huggingface.co 会超时），
# 要用官方源或自建镜像再取消下面这行注释
# HF_ENDPOINT=https://huggingface.co

# Windows 不支持 symlink，关闭相关警告
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Web 界面端口（默认 7860；被占用或要跑多个实例时改这里）
# PORT=7860

# ── 快递查询（可选：快递鸟免费接口）──────────────────────────
# 到 https://www.kdniao.com 免费注册，申请「即时查询」接口后获取
# 不配置时快递查询工具会提示用户，其余功能不受影响
# KDNIAO_EBUSINESS_ID=你的商户ID
# KDNIAO_APP_KEY=你的接口Key

# ── QQ 音乐（可选）────────────────────────────────────────
# 本机装了 QQ 音乐客户端就能点歌和控制播放，一般不用配（会自动查注册表）
# 装在非常规位置时，取消注释并填安装目录或 exe 完整路径
# QQMUSIC_PATH=D:\QQYINYUE\QQMusic\QQMusic2131.20.49.42

# ── 声纹锁定（默认开启）───────────────────────────────────
# 识别并记忆主人的声音：连接后第一次说「小音」录入声纹，
# 之后只有主人的声音能唤醒；重置对话/重新连接后重新录入
# 1=开，0=关
SPEAKER_LOCK=1
# 匹配阈值（余弦相似度 0~1，越大越严格；误拒绝多就调低到 0.5）
# 每次比对都会在日志里打出实际相似度（[声纹] 相似度 0.68（阈值 0.60）→ 通过），
# 照着自己的数值调比瞎试准：主人自己被拒时那个数是多少，阈值就设得比它低一点
SPEAKER_THRESHOLD=0.6
