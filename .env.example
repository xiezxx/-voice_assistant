# Claude API Key (从 https://console.anthropic.com 获取)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Whisper 模型大小: tiny, base, small, medium, large-v3
# tiny 适合快速测试，medium/large 精度更高
WHISPER_MODEL=base

# 使用的设备: cpu 或 cuda
WHISPER_DEVICE=cpu

# 语音活动检测灵敏度 (0-1, 越低越灵敏)
VAD_THRESHOLD=0.02

# 静音多少秒后判定用户说完话
SILENCE_DURATION=1.0

# HuggingFace Token (从 https://huggingface.co/settings/tokens 创建，可选)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace 国内镜像（国内用户建议设置，可选）
HF_ENDPOINT=https://hf-mirror.com

# Windows 不支持 symlink，关闭相关警告
HF_HUB_DISABLE_SYMLINKS_WARNING=1
